<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_bg">

    <!-- AUTH -->
    <ScrollView
        android:id="@+id/layoutAuth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvBadgeSecurityAuth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_search_box"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="@string/security_badge"
                    android:textColor="@color/vault_neon"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/tvBadgeSecurityAuth"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_container"
                        android:contentDescription="@string/cd_shield_icon"
                        android:padding="8dp"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/vault_neon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/app_name"
                        android:textColor="@color/vault_text_white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Biểu tượng khóa -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_lock_glow_circle">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_lock_icon"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/vault_neon" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="@string/auth_title"
                android:textColor="@color/vault_text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="12dp"
                android:text="@string/auth_subtitle"
                android:textColor="@color/vault_text_gray"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <!-- Khung nhập PIN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/vault_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/vault_card_stroke"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <!-- Nút Vân Tay -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAuthTouch"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/vault_card_stroke"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/vault_neon"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_fingerprint_icon"
                            android:src="@drawable/ic_fingerprint"
                            app:tint="@color/vault_neon" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Nút ẩn/hiện PIN -->
                    <ImageView
                        android:id="@+id/ivTogglePin"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="6dp"
                        android:layout_toStartOf="@id/btnAuthTouch"
                        android:contentDescription="@string/cd_toggle_pin"
                        android:padding="6dp"
                        android:src="@drawable/selector_eye_toggle"
                        app:tint="@color/vault_text_gray" />

                    <!-- Ô nhập PIN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:layout_toStartOf="@id/ivTogglePin"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_pin_label"
                            android:textColor="@color/vault_text_gray"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etMasterPin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:background="@null"
                            android:hint="@string/auth_pin_hint"
                            android:inputType="numberPassword"
                            android:maxLength="6"
                            android:padding="0dp"
                            android:textColor="@color/vault_text_white"
                            android:textColorHint="@color/vault_text_dim"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nút xác thực chính -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAuthPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/vault_neon"
                android:minHeight="52dp"
                android:text="@string/auth_btn_unlock"
                android:textColor="@color/vault_bg"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- DASHBOARD -->
    <RelativeLayout
        android:id="@+id/layoutDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:visibility="gone">

        <!-- Top Header -->
        <RelativeLayout
            android:id="@+id/dashHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/headerActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBenchmark"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/dash_btn_benchmark"
                    android:textColor="@color/vault_text_gray"
                    android:textSize="11sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/vault_card_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLock"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/vault_neon_dark"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/dash_btn_lock"
                    android:textColor="@color/vault_neon"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@id/headerActions"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_container"
                    android:contentDescription="@string/cd_shield_icon"
                    android:padding="9dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/vault_neon" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/app_name"
                        android:textColor="@color/vault_text_white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/dash_status_offline"
                        android:textColor="@color/vault_text_dim"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Thanh tìm kiếm & Lọc phân loại -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/dashHeader"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:minHeight="46dp"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/cd_search_icon"
                android:src="@drawable/ic_search"
                app:tint="@color/vault_text_dim" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:autofillHints="name"
                android:background="@null"
                android:hint="@string/dash_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/vault_text_white"
                android:textColorHint="@color/vault_text_dim"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnFilter"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_container"
                android:clickable="true"
                android:contentDescription="@string/cd_filter_icon"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_filter"
                app:tint="@color/vault_text_dim" />
        </LinearLayout>

        <!-- Thống kê -->
        <RelativeLayout
            android:id="@+id/subHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/searchBar"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textColor="@color/vault_text_dim"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@id/tvCount"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dash_sub_status"
                    android:textColor="@color/vault_neon"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/dash_sub_title"
                    android:textColor="@color/vault_text_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Danh sách thẻ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            android:layout_below="@id/subHeader"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingBottom="88dp" />

        <!-- Nút thêm mới -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/vault_neon"
            android:contentDescription="@string/add_title"
            android:src="@drawable/ic_add"
            app:borderWidth="0dp"
            app:elevation="6dp"
            app:tint="@color/vault_bg" />
    </RelativeLayout>

    <!-- ADD / EDIT -->
    <ScrollView
        android:id="@+id/layoutAdd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/add_screen_bg"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Top Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    app:drawableStartCompat="@drawable/ic_back"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="@string/add_btn_back"
                    android:textColor="@color/vault_teal_btn"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:drawableTint="@color/vault_teal_btn" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveData"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:backgroundTint="@color/vault_teal_btn"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/add_btn_save"
                    android:textColor="@color/add_on_accent"
                    android:textSize="13sp"
                    app:cornerRadius="20dp" />

                <TextView
                    android:id="@+id/tvAddTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/btnBack"
                    android:layout_toStartOf="@id/btnSaveData"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:singleLine="true"
                    android:text="@string/add_title"
                    android:textColor="@color/add_title_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Thông báo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/add_notice_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="@string/add_encrypted_notice"
                    android:textColor="@color/vault_teal_btn"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/add_label_title"
                android:textColor="@color/add_label_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTitleInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:autofillHints="name"
                android:background="@drawable/bg_input_light"
                android:hint="@string/add_hint_title"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/add_input_text"
                android:textColorHint="@color/add_hint_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/add_label_category"
                android:textColor="@color/add_label_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/add_cat_password"
                    android:textColor="@color/add_label_text" />

                <RadioButton
                    android:id="@+id/rbBank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_cat_bank"
                    android:textColor="@color/add_label_text" />

                <RadioButton
                    android:id="@+id/rbNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_cat_note"
                    android:textColor="@color/add_label_text" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/add_label_content"
                android:textColor="@color/add_label_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etContentInput"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:autofillHints="name"
                android:background="@drawable/bg_input_light"
                android:gravity="top|start"
                android:hint="@string/add_hint_content"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="@color/add_input_text"
                android:textColorHint="@color/add_hint_text"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbAutoClearClipboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:button="@drawable/selector_checkbox"
                android:buttonTint="@color/vault_teal_btn"
                android:checked="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/add_checkbox_clipboard"
                android:textColor="@color/add_label_text"
                android:textSize="13sp" />

            <!-- Nút Xóa bản ghi (chỉ hiển thị khi Edit Note) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteNote"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/danger"
                android:text="@string/add_btn_delete"
                android:textColor="@color/add_on_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="20dp" />

            <!-- Card trạng thái -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/add_notice_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/cd_shield_icon"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/add_status_icon" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/add_status_label"
                            android:textColor="@color/add_status_icon"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/add_status_tech"
                            android:textColor="@color/vault_teal_btn"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</FrameLayout>