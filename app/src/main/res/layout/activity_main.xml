<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_bg">

    <!-- ======================================================== -->
    <!-- 1. MÀN HÌNH KHỞI ĐỘNG & MỞ KHÓA (AUTH SCREEN) -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layoutAuth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="30dp"
        android:visibility="visible">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_container"
                    android:gravity="center"
                    android:text="🛡️"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="SecureVault"
                    android:textColor="@color/vault_text_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_search_box"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="• BẢO MẬT"
                android:textColor="@color/vault_neon"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Biểu tượng khóa phát sáng -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="50dp"
            android:background="@drawable/bg_lock_glow_circle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔒"
                android:textSize="44sp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:letterSpacing="0.04"
            android:text="DỮ LIỆU ĐÃ ĐƯỢC MÃ HÓA"
            android:textColor="@color/vault_text_white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="16dp"
            android:text="Chạm vân tay hoặc nhập mã PIN Master để giải mã khóa truy cập (Keystore)"
            android:textColor="@color/vault_text_gray"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Nút chạm cảm ứng -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAuthTouch"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/vault_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/vault_card_stroke"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_lock_glow_circle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="👆"
                        android:textSize="20sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chạm cảm ứng"
                        android:textColor="@color/vault_text_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xác thực nhanh bằng vân tay"
                        android:textColor="@color/vault_text_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/vault_text_dim"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dải phân cách HOẶC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/vault_card_stroke" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="HOẶC"
                android:textColor="@color/vault_text_dim"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/vault_card_stroke" />
        </LinearLayout>

        <!-- Khung Nhập PIN Master Thật -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:cardBackgroundColor="@color/vault_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/vault_card_stroke"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/ivTogglePin"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nhập Master PIN"
                        android:textColor="@color/vault_text_gray"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etMasterPin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="Nhập 6 số PIN..."
                        android:inputType="numberPassword"
                        android:maxLength="6"
                        android:padding="0dp"
                        android:textColor="@color/vault_text_white"
                        android:textColorHint="@color/vault_text_dim"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivTogglePin"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:alpha="0.6"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="@color/vault_text_gray" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nút xác thực chính -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuthPin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/vault_neon"
            android:text="🔒 XÁC THỰC &amp; MỞ KHÓA KHO LƯU TRỮ"
            android:textColor="@color/vault_bg"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <!-- Footer Keystore Alias -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/vault_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔑 Keystore Alias"
                    android:textColor="@color/vault_text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="vault_master_key"
                    android:textColor="@color/vault_text_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 2. MÀN HÌNH DASHBOARD (KHO DỮ LIỆU ĐÃ GIẢI MÃ) -->
    <!-- ======================================================== -->
    <RelativeLayout
        android:id="@+id/layoutDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:visibility="gone">

        <!-- Top Header -->
        <RelativeLayout
            android:id="@+id/dashHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_container"
                    android:gravity="center"
                    android:text="🛡️"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SecureVault"
                        android:textColor="@color/vault_text_white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOCAL · OFFLINE"
                        android:textColor="@color/vault_text_dim"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBenchmark"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="10dp"
                    android:text="⏱ Benchmark"
                    android:textColor="@color/vault_text_gray"
                    android:textSize="11sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/vault_card_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLock"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/vault_neon_dark"
                    android:paddingHorizontal="12dp"
                    android:text="🔒 Khóa"
                    android:textColor="@color/vault_neon"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Thanh tìm kiếm có nút Command K -->
        <FrameLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@id/dashHeader"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_search_box"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="🔍  Tìm kiếm dữ liệu đã mã hóa..."
                android:textColor="@color/vault_text_dim"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_icon_container"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="⌘ K"
                android:textColor="@color/vault_text_dim"
                android:textSize="11sp" />
        </FrameLayout>

        <!-- Thống kê Header -->
        <RelativeLayout
            android:id="@+id/subHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/searchBar"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AES-256 · ĐÃ XÁC THỰC"
                    android:textColor="@color/vault_neon"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Dữ liệu được mã hóa"
                    android:textColor="@color/vault_text_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="03 MỤC"
                android:textColor="@color/vault_text_dim"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Danh sách thẻ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottomNotice"
            android:layout_below="@id/subHeader"
            android:layout_marginTop="12dp" />

        <!-- Banner thông báo xanh lá đậm -->
        <LinearLayout
            android:id="@+id/bottomNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/dbFooter"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_footer_banner"
            android:gravity="center_vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:lineSpacingExtra="2dp"
                android:text="Khóa chính được bảo vệ trên thiết bị. Không dữ liệu nào rời khỏi SecureVault."
                android:textColor="@color/vault_neon"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Dòng địa chỉ DB ở đáy -->
        <LinearLayout
            android:id="@+id/dbFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_container"
                android:gravity="center"
                android:text="🗄️"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• CƠ SỞ DỮ LIỆU CỤC BỘ"
                    android:textColor="@color/vault_neon"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/data/data/com.example.project_gk/databases/vault.db"
                    android:textColor="@color/vault_text_dim"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nút tròn thêm mới FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/bottomNotice"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/vault_neon"
            android:src="@android:drawable/ic_input_add"
            app:borderWidth="0dp"
            app:elevation="6dp"
            app:tint="@color/vault_bg" />
    </RelativeLayout>

    <!-- ======================================================== -->
    <!-- 3. MÀN HÌNH THÊM DỮ LIỆU MỚI (NỀN SÁNG ELEGANT) -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layoutAdd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8FAFA"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:visibility="gone">

        <!-- Top Header Nền Sáng -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="‹ Quay lại"
                android:textColor="@color/vault_teal_btn"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Thêm Dữ Liệu Mới"
                android:textColor="#192420"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveData"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:backgroundTint="@color/vault_teal_btn"
                android:text="Lưu"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:cornerRadius="20dp" />
        </RelativeLayout>

        <!-- Thẻ thông báo trên đầu -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#E6F4F1"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="🔒  DỮ LIỆU ĐƯỢC MÃ HÓA TRÊN THIẾT BỊ"
                android:textColor="@color/vault_teal_btn"
                android:textSize="12sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tiêu đề bản ghi:"
            android:textColor="#2A3833"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTitleInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_light"
            android:hint="Ví dụ: Mã PIN"
            android:paddingHorizontal="14dp"
            android:textColor="#1A2420"
            android:textColorHint="#94A39D"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Phân loại:"
            android:textColor="#2A3833"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/rbPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Mật khẩu"
                android:textColor="#2A3833" />

            <RadioButton
                android:id="@+id/rbBank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thẻ ngân hàng"
                android:textColor="#2A3833" />

            <RadioButton
                android:id="@+id/rbNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ghi chú"
                android:textColor="#2A3833" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nội dung bí mật:"
            android:textColor="#2A3833"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etContentInput"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_light"
            android:gravity="top|start"
            android:hint="Nhập nội dung cần mã hóa tại đây..."
            android:padding="14dp"
            android:textColor="#1A2420"
            android:textColorHint="#94A39D"
            android:textSize="14sp" />

        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="Tự động xóa khỏi Clipboard sau 30 giây"
            android:textColor="#2A3833"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Card Trạng thái ở đáy -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#E6F4F1"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️"
                    android:textSize="20sp" />

